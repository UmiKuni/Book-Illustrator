# Server-only Gemini credential; never commit the corresponding .env file.
GEMINI_API_KEY=

# Verify these model IDs against the account's available models before each demo.
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# Local runtime configuration.
APP_DATA_DIR=./data
STEP_STALE_AFTER_MS=300000
